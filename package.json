{
  "name": "blockchain-wasm",
  "version": "4.0.0",
  "description": "Motor criptográfico zero-alloc para wallets Bitcoin y Ethereum: un único binario WebAssembly (AssemblyScript) con un wrapper TypeScript ergonómico de clases de dominio. secp256k1, BIP-32/39/44, Schnorr (BIP-340), ECDSA, ECDH, direcciones P2PKH/P2SH-P2WPKH/P2TR/ETH, WIF y PBKDF2 — sin heap, sin memory.grow, isomórfico (Node, Bun, Deno y navegador).",
  "author": "Edison Manrique",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blockchain-wasm.wasm": "./dist/blockchain-wasm.wasm",
    "./dist/blockchain-wasm.wasm": "./dist/blockchain-wasm.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "asbuild": "asc assembly/index.ts --target release",
    "tsbuild": "esbuild src/index.ts --outfile=dist/index.js --format=esm --platform=browser --bundle --minify && tsc --emitDeclarationOnly",
    "release": "bun run asbuild && bun run tsbuild",
    "prepublishOnly": "npm run release",
    "pack": "npm pack --dry-run",
    "publish": "npm publish --access public",
    "prebuild": "bun run scripts/prebuild-tests.ts",
    "test": "bun test",
    "test:parallel": "bun test --parallel",
    "test:all": "bun run prebuild && bun test",
    "test:cold": "bun run scripts/prebuild-tests.ts --clear --force && bun test",
    "test:watch": "bun test --watch",
    "bench": "bun test/bench.ts",
    "bench:wrapper": "bun run scripts/bench-wrapper.ts",
    "deploy:pages": "node deploy_pages.cjs"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "assemblyscript",
    "cryptography",
    "secp256k1",
    "ecdsa",
    "schnorr",
    "bip340",
    "ecdh",
    "bip32",
    "bip39",
    "bip44",
    "hd-wallet",
    "mnemonic",
    "bitcoin",
    "ethereum",
    "taproot",
    "bech32",
    "wif",
    "keccak256",
    "sha256",
    "pbkdf2",
    "zero-alloc",
    "typescript",
    "isomorphic",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/edison-manrique/blockchain-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/edison-manrique/blockchain-wasm/issues"
  },
  "homepage": "https://github.com/edison-manrique/blockchain-wasm#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "assemblyscript": "0.28.20",
    "esbuild": "0.25.11",
    "typescript": "^7.0.2"
  }
}
